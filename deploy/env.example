# Virtuozzo Application Management Assistant environment (example) — /etc/vap-copilot.env
# Install: sudo install -m 0640 -o root -g vap-copilot deploy/env.example /etc/vap-copilot.env
# then fill in VAP_LLM_API_KEY. NEVER commit the real file anywhere.

# OpenAI-compatible LLM endpoint
VAP_LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
VAP_LLM_MODEL=mimo-v2.6-pro
VAP_LLM_API_KEY=REPLACE_ME

# Bind address for the combined server (Caddy proxies to 127.0.0.1:8080)
VAP_SERVE_HOST=127.0.0.1
VAP_SERVE_PORT=8080
